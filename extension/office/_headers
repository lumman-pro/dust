# Office on the web frames the task pane from Microsoft sites (Excel, Teams, Outlook, SharePoint...).
# Microsoft publishes no list of them, hence wide wildcards. X-Frame-Options cannot list sites.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
  Strict-Transport-Security: max-age=86400
  Content-Security-Policy: frame-ancestors https://*.cloud.microsoft https://*.live.com https://*.microsoft.com https://*.microsoft365.com https://*.office.com https://*.office365.com https://*.sharepoint.com

# HTML and manifests use Cloudflare's default max-age=0, must-revalidate.
# Only content-hashed bundles/fonts get an immutable browser cache.
/excel/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the auth callback (its query string contains a one-time code).
/excel/auth.html
  Cache-Control: no-store
